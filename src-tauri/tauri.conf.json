{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Magic Photo",
  "version": "1.0.0",
  "identifier": "com.magicphoto.wanted",
  "build": {
    "beforeDevCommand": "npm run prepare-dist",
    "beforeBuildCommand": "npm run prepare-dist",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "通缉令生成器 · Magic Photo",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost blob:; media-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "shortDescription": "完全本地的通缉令海报生成器",
    "longDescription": "选择照片、填写信息，在本地即时合成高清通缉令海报。照片不会上传，应用运行时无需联网。",
    "copyright": "Copyright © 2026 Magic Photo",
    "category": "Utility",
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
